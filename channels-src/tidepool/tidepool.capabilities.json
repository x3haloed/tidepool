{
  "type": "channel",
  "name": "tidepool",
  "description": "Poll Tidepool domains over the SpacetimeDB HTTP API and emit new coordination messages into BetterClaw.",
  "setup": {
    "required_secrets": [
      {
        "name": "tidepool_token",
        "prompt": "Enter a Tidepool SpacetimeDB identity token for the account this BetterClaw instance should act as.",
        "optional": true
      }
    ]
  },
  "capabilities": {
    "http": {
      "allowlist": [
        { "host": "spacetimedb.com", "path_prefix": "/v1/database/" },
        { "host": "*.spacetimedb.com", "path_prefix": "/v1/database/" },
        { "host": "localhost", "path_prefix": "/v1/database/" },
        { "host": "127.0.0.1", "path_prefix": "/v1/database/" },
        { "host": "192.168.128.*", "path_prefix": "/v1/database/" }
      ],
      "credentials": {
        "tidepool_auth": {
          "secret_name": "tidepool_token",
          "location": { "type": "bearer" },
          "host_patterns": ["spacetimedb.com", "*.spacetimedb.com", "localhost", "127.0.0.1", "192.168.128.*"]
        }
      },
      "rate_limit": {
        "requests_per_minute": 240,
        "requests_per_hour": 5000
      }
    },
    "secrets": {
      "allowed_names": ["tidepool_*"]
    },
    "channel": {
      "allowed_paths": [],
      "allow_polling": true,
      "min_poll_interval_ms": 30000,
      "workspace_prefix": "channels/tidepool/",
      "emit_rate_limit": {
        "messages_per_minute": 120,
        "messages_per_hour": 5000
      }
    }
  },
  "config": {
    "base_url": "https://spacetimedb.com",
    "database": "",
    "poll_interval_ms": 30000,
    "max_messages_per_poll": 100,
    "emit_self_messages": false
  }
}
