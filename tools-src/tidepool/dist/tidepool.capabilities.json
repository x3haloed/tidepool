{
  "http": {
    "allowlist": [
      {
        "host": "spacetimedb.com",
        "path_prefix": "/v1/database/",
        "methods": ["GET", "POST"]
      },
      {
        "host": "localhost",
        "path_prefix": "/v1/database/",
        "methods": ["GET", "POST"]
      },
      {
        "host": "127.0.0.1",
        "path_prefix": "/v1/database/",
        "methods": ["GET", "POST"]
      },
      {
        "host": "192.168.128.*",
        "path_prefix": "/v1/database/",
        "methods": ["GET", "POST"]
      }
    ],
    "credentials": {
      "tidepool_token": {
        "secret_name": "tidepool_token",
        "location": { "type": "bearer" },
        "host_patterns": ["spacetimedb.com", "localhost", "127.0.0.1", "192.168.128.*"]
      }
    },
    "rate_limit": {
      "requests_per_minute": 120,
      "requests_per_hour": 5000
    },
    "timeout_secs": 30,
    "max_response_bytes": 1048576
  },
  "secrets": {
    "allowed_names": ["tidepool_token", "tidepool_*"]
  },
  "auth": {
    "secret_name": "tidepool_token",
    "display_name": "Tidepool",
    "instructions": "Enter a SpacetimeDB auth token for the Tidepool database if you want authenticated reducers or caller-scoped views. Public read-only SQL may work without it depending on deployment policy.",
    "setup_url": "https://spacetimedb.com/docs",
    "token_hint": "SpacetimeDB bearer token",
    "env_var": "TIDEPOOL_TOKEN"
  },
  "setup": {
    "required_secrets": [
      {
        "name": "tidepool_token",
        "prompt": "Optional SpacetimeDB bearer token for authenticated Tidepool access",
        "optional": true
      }
    ]
  }
}
